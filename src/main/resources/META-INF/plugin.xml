<idea-plugin>
    <id>com.dennislang.build-sound</id>
    <name>Build Sound Notifier</name>
    <version>6.07.21</version>
    <vendor url="https://landenlabs.com">LanDen Labs - Dennis Lang</vendor>

    <description><![CDATA[
        Plays a short audio tone when a project build finishes.<br/>
        <ul>
            <li>Ascending two-note chime on success</li>
            <li>Descending two-note tone on failure</li>
            <li>Configurable via <b>Settings → Tools → Build Sound</b></li>
        </ul>
        <p>Source: <a href="https://github.com/landenlabs/as-plugin-sound">github.com/landenlabs/as-plugin-sound</a></p>
        <p>Copyright (c) 2026 LanDen Labs - Dennis Lang</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.dennislang.buildsound.BuildSoundSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.dennislang.buildsound.BuildSoundConfigurable"
                id="com.dennislang.build-sound.settings"
                displayName="Build Sound"/>
    </extensions>

    <projectListeners>
        <listener class="com.dennislang.buildsound.BuildSoundListener"
                  topic="com.intellij.task.ProjectTaskListener"/>
    </projectListeners>
</idea-plugin>
