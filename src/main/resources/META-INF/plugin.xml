<idea-plugin>
    <id>com.landenlabs.build-sound</id>
    <name>All Build Sound Notifier</name>
    <version>6.11.09</version>
    <vendor url="https://landenlabs.com">LanDen Labs - Dennis Lang</vendor>

    <description><![CDATA[
        Plays a short audio tone when a project build finishes.<br/>
        <ul>
            <li>Ascending two-note chime on success</li>
            <li>Descending two-note tone on failure</li>
            <li>Ascending three-note chime when the app finishes installing/launching on a device</li>
            <li>Configurable via <b>Tools → Build Sound Settings…</b> or <b>Settings → Tools → Build Sound</b></li>
        </ul>
        <p>Source: <a href="https://github.com/landenlabs/as-plugin-sound">github.com/landenlabs/as-plugin-sound</a></p>
        <p>Copyright (c) 2026 LanDen Labs - Dennis Lang</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.landenlabs.buildsound.BuildSoundSettings"/>
        <applicationConfigurable
                parentId="tools"
                instance="com.landenlabs.buildsound.BuildSoundConfigurable"
                id="com.landenlabs.build-sound.settings"
                displayName="Build Sound"/>
        <postStartupActivity implementation="com.landenlabs.buildsound.BuildSoundStartupActivity"/>
        <notificationGroup id="Build Sound" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="com.landenlabs.buildsound.OpenSettings"
                class="com.landenlabs.buildsound.OpenBuildSoundSettingsAction"
                text="Build Sound Settings…"
                description="Open Settings → Tools → Build Sound">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="com.landenlabs.buildsound.RunSoundListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
